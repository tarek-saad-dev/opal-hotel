# Base URL of the backend API used by the public forms (booking request,
# contact, reviews). See docs/BACKEND_API.md for the contract.
# Leave empty to call the same origin under /api/v1 (e.g. behind a reverse proxy).
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com/v1

# Opal Poolside Laravel booking integration (separate from legacy forms)
# Enable only in approved test environment until release gates are signed off.
OPAL_BOOKING_ENABLED=false
# Origin only; no /api/v1. This origin is shared with the browser for CORS.
# OPAL_API_BASE_URL=http://127.0.0.1:8000
# OPAL_PAYMENT_GATEWAY=mock # loopback only; default paymob

# Separate B2B portal flag; leave off until Laravel agency permissions are verified.
OPAL_AGENCY_ENABLED=false
# Exact trusted browser origin, required for agency mutations (CSRF protection).
# OPAL_AGENCY_PUBLIC_ORIGIN=https://opal.example.com
